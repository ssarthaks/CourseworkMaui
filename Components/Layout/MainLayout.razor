@using ExpenwiseTracker.Services
@using MudBlazor
@inherits LayoutComponentBase
@using ExpenwiseTracker.Services.Interface
@inject IUserService UserService
@inject NavigationManager NavigationManager

@if (NavigationManager.Uri.Contains("/auth/login"))
{
    @Body
}
else
{
    if (!UserService.IsUserAuthenticated())
    {
        NavigationManager.NavigateTo("/auth/login", true);
    }
    else
    {
        <div class="page" style="background-color: #E9ECFE;">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <article class="content" style="padding-bottom:25px; background-color: #E9ECFE;">
                    @Body
                </article>
            </main>
        </div>
    }
}
