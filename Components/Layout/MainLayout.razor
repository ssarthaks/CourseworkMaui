@using ExpenwiseTracker.Services
@using MudBlazor
@inherits LayoutComponentBase
@inject TransactionService TransactionService

<MudBlazor.MudDialogProvider />
<MudSnackbarProvider />

<div class="page" style="background-color: #E9ECFE; height:100vh; overflow:hidden;">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <h1 style="font-weight:700; font-size:20px; color: #4E55C2;">User: Sarthak</h1>
            <h1 style="font-weight:700; font-size:20px; color: #4E55C2;">Balance: @totalBalance USD</h1>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private double totalBalance;

    // Override OnInitializedAsync to fetch balance when the component is first loaded
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UpdateBalance();
        }
        catch (Exception ex)
        {
            // Handle error (e.g., log)
        }
    }

    // Method to fetch and update the balance
    private async Task UpdateBalance()
    {
        totalBalance = await TransactionService.CalculateUserBalanceAsync();
        StateHasChanged();  // This triggers a UI refresh after the balance is updated
    }

    // Call this method when a transaction is added
    public async Task OnTransactionAdded()
    {
        // Add the new transaction to the service, then refresh the balance
        await UpdateBalance();
    }
}