@using ExpenwiseTracker.Services
@using MudBlazor
@inherits LayoutComponentBase
@using ExpenwiseTracker.Services.Interface
@inject IUserService UserService
@inject NavigationManager NavigationManager

@if (NavigationManager.Uri.Contains("/auth/login"))
{

    <div style="background-color:black; height:100vh; width:100vw; opacity:70%; position:absolute;"></div>
    <article style="
    background-image: url(https://venuske.com/wp-content/uploads/2024/05/venus-forex-bureau-limited-money-exchange-venuske.com_-2048x1334.jpg);
    background-size: cover;
    height: 100vh;">
        @Body
    </article>
}
else
{
    if (!UserService.IsUserAuthenticated())
    {
        NavigationManager.NavigateTo("/auth/login", true);
    }
    else
    {
        <div class="page" style="background-color: #E9ECFE;">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <article class="content" style="padding-bottom:25px; background-color: #E9ECFE;">
                    @Body
                </article>
            </main>
        </div>
    }
}

