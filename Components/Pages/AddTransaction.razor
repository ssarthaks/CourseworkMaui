@page "/addtransactions"

@inject NavigationManager Navigation
@using ExpenwiseTracker.Model
@using ExpenwiseTracker.Services
@inject TransactionService TransactionService
@using MudBlazor

<div class="add-transactions-container">
    <h1 class="add-transactions-title">Add Transaction</h1>

    @if (!string.IsNullOrEmpty(NotifyUser))
    {
        <div class="alert @NotifyUserClass">
            @NotifyUser
        </div>
    }

    <!-- Transaction Form -->
    <EditForm Model="@transaction" OnValidSubmit="SubmitTransaction">
        <div class="add-transactions-form-card">
            <div class="add-transactions-form-row">
                <div class="add-transactions-form-group">
                    <label for="type">Type</label>
                    <InputSelect @bind-Value="transaction.Type" required class="form-control">
                        <option value="">Select Type</option>
                        <option value="Debit">Debit</option>
                        <option value="Credit">Credit</option>
                        <option value="Debt">Debt</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => transaction.Type)" />
                </div>

                <div class="add-transactions-form-group">
                    <label for="name">Name</label>
                    <InputText id="name" @bind-Value="transaction.Name" required class="form-control" />
                    <ValidationMessage For="@(() => transaction.Name)" />
                </div>
            </div>

            <div class="add-transactions-form-row">
                <div class="add-transactions-form-group">
                    <label for="amount">Amount</label>
                    <InputNumber id="amount" @bind-Value="transaction.Amount" required class="form-control" />
                    <ValidationMessage For="@(() => transaction.Amount)" />
                </div>

                <div class="add-transactions-form-group">
                    <label for="tag">Tag</label>
                    <InputText id="tag" @bind-Value="transaction.Tag" class="form-control" />
                    <ValidationMessage For="@(() => transaction.Tag)" />
                </div>
            </div>

            <div class="add-transactions-form-group">
                <label for="notes">Notes</label>
                <InputText id="notes" @bind-Value="transaction.Notes" class="form-control" />
                <ValidationMessage For="@(() => transaction.Notes)" />
            </div>

            @if (transaction.Type == "Debt")
            {
                <div class="add-transactions-form-row">
                    <div class="add-transactions-form-group">
                        <label for="source">Source</label>
                        <InputText id="source" @bind-Value="transaction.Source" class="form-control" />
                        <ValidationMessage For="@(() => transaction.Source)" />
                    </div>

                    <div class="add-transactions-form-group">
                        <label for="dueDate">Due Date</label>
                        <InputDate id="dueDate" @bind-Value="transaction.DueDate" class="form-control" />
                        <ValidationMessage For="@(() => transaction.DueDate)" />
                    </div>
                </div>
            }

            <button type="submit" class="btn btn-primary" disabled="@IsSubmitDisabled()">Add Transaction</button>
        </div>
    </EditForm>

    <!-- Pagination Table for Transactions -->
    <MudTable Items="@paginatedTransactions" Striped="true" Hover="true" Bordered="true" Paginated="true" RowsPerPage="5" CurrentPage="@currentPage" OnPageChanged="OnPageChanged">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Tag</MudTh>
            <MudTh>Notes</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Type</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Amount</MudTd>
            <MudTd>@context.Tag</MudTd>
            <MudTd>@context.Notes</MudTd>
        </RowTemplate>
    </MudTable>

</div>

@code {
    private Transaction transaction = new Transaction();
    private string NotifyUser;
    private string NotifyUserClass;
    private bool isSubmitDisabled = false;

    // To hold the full list of transactions (can be large)
    private List<Transaction> allTransactions = new List<Transaction>();

    // To hold the currently paginated transactions
    private List<Transaction> paginatedTransactions = new List<Transaction>();

    // Pagination state
    private int currentPage = 0;
    private const int rowsPerPage = 5;
    private double userBalance;

    // On initialization, fetch transactions and balance
    protected override async Task OnInitializedAsync()
    {
        try
        {
            userBalance = await TransactionService.CalculateUserBalanceAsync();
            allTransactions = await TransactionService.RetrieveAllTransactions();
            UpdatePagination();
        }
        catch (Exception ex)
        {
            NotifyUser = "Error fetching balance: " + ex.Message;
            NotifyUserClass = "alert-danger";
        }
    }

    // Handle transaction submission
    private async Task SubmitTransaction()
    {
        try
        {
            if ((transaction.Type == "Debit" || transaction.Type == "Debt") && transaction.Amount > userBalance)
            {
                NotifyUser = "Insufficient balance!";
                NotifyUserClass = "alert-danger";
                StateHasChanged();
                return;
            }

            await TransactionService.AddTransactionAsync(transaction);
            userBalance = await TransactionService.CalculateUserBalanceAsync();
            allTransactions = await TransactionService.RetrieveAllTransactions();
            UpdatePagination(); // Update pagination after adding a transaction
            NotifyUser = "Transaction added successfully!";
            NotifyUserClass = "alert-success";
            transaction = new Transaction();
        }
        catch (Exception ex)
        {
            NotifyUser = "Error adding transaction: " + ex.Message;
            NotifyUserClass = "alert-danger";
        }
    }

    // Handle pagination page change
    private void OnPageChanged(int newPage)
    {
        currentPage = newPage;
        UpdatePagination();
    }

    // Method to update the paginated transactions based on the current page
    private void UpdatePagination()
    {
        int skip = currentPage * rowsPerPage;
        paginatedTransactions = allTransactions.Skip(skip).Take(rowsPerPage).ToList();
    }

    // Disable submit if transaction exceeds balance
    private bool IsSubmitDisabled()
    {
        if ((transaction.Type == "Debit" || transaction.Type == "Debt") && transaction.Amount > userBalance)
        {
            NotifyUser = "Error: Transaction amount exceeds balance.";
            NotifyUserClass = "alert-danger";
            return true;
        }
        return false;
    }
}
