@page "/"
@using ExpenwiseTracker.Model
@using ExpenwiseTracker.Services.Interface
@inject ExpenwiseTracker.Services.DbConnectionService DatabaseService
@inject ITransactionService TransactionService
@inject IJSRuntime JSRuntime

<div class="dashboard">
    <div class="metrics">
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Total Inflow</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon inflow"><path d="m18 15-6-6-6 6" /></svg>
            </div>
            <div class="metric-amount inflow">@userCurrency @totalInflow</div>
        </div>
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Total Outflow</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon outflow"><path d="m6 9 6 6 6-6" /></svg>
            </div>
            <div class="metric-amount outflow">@userCurrency @totalOutflow</div>
        </div>
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Total Debts</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon debt"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
            </div>
            <div class="metric-amount debt">@userCurrency @totalDebts</div>
        </div>
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Cleared Debts</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon inflow"><path d="M20 6 9 17l-5-5" /></svg>
            </div>
            <div class="metric-amount inflow">@userCurrency @clearedDebts</div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="statistics-column">
            <div class="stat-card">
                <div class="stat-title">Inflow Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-green">@userCurrency. @highestInflow</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-green">@userCurrency. @lowestInflow</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-title">Outflow Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-red">@userCurrency. @highestOutflow</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-red">@userCurrency. @lowestOutflow</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-title">Debt Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-yellow">@userCurrency. @highestDebt</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-yellow">@userCurrency. @lowestDebt</span>
                </div>
            </div>
        </div>

        <div class="transactions-card">
            <div class="stat-title">Top 5 Transactions</div>
            @foreach (var transaction in topTransactions)
            {
                <div class="transaction-item">
                    <span>@transaction.Date.ToString("yyyy-MM-dd")</span>
                    <span>@transaction.Name</span>
                    <span class="tag @(transaction.Tag?.ToLower() ?? "no-tag")">@transaction.Tag</span>
                    <span style="font-weight:500;" class="amount-@(
                        transaction.Type == "Credit" ? "green" :
                        transaction.Type == "Debit" ? "red" :
                        transaction.Type == "Debt" ? "yellow" : "default")">
                        @userCurrency. @transaction.Amount
                    </span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private double currentBalance;
    private double totalInflow;
    private double totalOutflow;
    private double totalDebts;
    private double clearedDebts;

    private double highestInflow;
    private double lowestInflow;
    private double highestOutflow;
    private double lowestOutflow;
    private double highestDebt;
    private double lowestDebt;

    private List<Transaction> topTransactions = new List<Transaction>();

    // Currency from sessionStorage
    private string userCurrency = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Fetch currency from sessionStorage and load dashboard data
        userCurrency = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "preferredCurrency");
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        // Fetch transactions from the database asynchronously
        var transactions = DatabaseService.RetrieveAllTransactions();

        // Current balance calculation
        currentBalance = transactions
            .Where(t => (t.Type == "Credit" || t.Type == "Debt") && !t.IsPaid) // Include only unpaid debts
            .Sum(t => t.Amount) -
            transactions
            .Where(t => t.Type == "Debit")
            .Sum(t => t.Amount);

        // Filter transactions based on types
        var inflows = transactions.Where(t => t.Type == "Credit").ToList();
        var outflows = transactions.Where(t => t.Type == "Debit").ToList();
        var debts = transactions.Where(t => t.Type == "Debt").ToList();

        // Calculate total inflow, outflow, and debts
        totalInflow = inflows.Sum(t => t.Amount);
        totalOutflow = outflows.Sum(t => t.Amount);
        totalDebts = debts.Sum(t => t.Amount);
        clearedDebts = debts.Where(t => t.IsPaid).Sum(t => t.Amount);

        // Statistics calculations (handle empty lists to avoid exceptions)
        highestInflow = inflows.Any() ? inflows.Max(t => t.Amount) : 0;
        lowestInflow = inflows.Any() ? inflows.Min(t => t.Amount) : 0;
        highestOutflow = outflows.Any() ? outflows.Max(t => t.Amount) : 0;
        lowestOutflow = outflows.Any() ? outflows.Min(t => t.Amount) : 0;
        highestDebt = debts.Any() ? debts.Max(t => t.Amount) : 0;
        lowestDebt = debts.Any() ? debts.Min(t => t.Amount) : 0;

        // Get top 5 recent transactions
        topTransactions = transactions.OrderByDescending(t => t.Amount).Take(5).ToList();
    }
}
