@page "/"
@using ExpenwiseTracker.Model
@using ExpenwiseTracker.Services.Interface
@using MudBlazor
@inject ExpenwiseTracker.Services.DbConnectionService DatabaseService
@inject ITransactionService TransactionService
@inject IJSRuntime JSRuntime

<div class="dashboard">
    <!-- Current Balance Section -->
    <div class="current-balance-board">
        <div class="current-balance">
            <div>Username: </div>
            <div style="color:green; font-weight:700;">admin </div>
        </div>
        <div class="current-balance">
            <div>Available Balance: </div>
            <div style="color:green; font-weight:700;">@userCurrency @currentBalance.ToString("F2")</div>
        </div>
    </div>

    <!-- Metrics Section (Total Inflow, Outflow, Debts, and Cleared Debts) -->
    <div class="metrics">
        <!-- Total Inflow Metric -->
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Total Inflow</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon inflow">
                    <path d="m18 15-6-6-6 6" />
                </svg>
            </div>
            <div class="metric-amount inflow">@userCurrency @totalInflow</div>
        </div>

        <!-- Total Outflow Metric -->
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Total Outflow</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon outflow">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </div>
            <div class="metric-amount outflow">@userCurrency @totalOutflow</div>
        </div>

        <!-- Total Debts Metric -->
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Remaining Debts</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon debt">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </div>
            <div class="metric-amount debt">@userCurrency @remainingDebt</div>
        </div>

        <!-- Cleared Debts Metric -->
        <div class="card metric">
            <div class="metric-header">
                <div class="metric-title">Cleared Debts</div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metric-icon inflow">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
            </div>
            <div class="metric-amount inflow">@userCurrency @clearedDebts</div>
        </div>
    </div>

    <!-- Statistics Section (Highest, Lowest Inflow/Outflow/Debt) -->
    <div class="dashboard-content">
        <div class="statistics-column">
            <!-- Inflow Statistics -->
            <div class="stat-card">
                <div class="stat-title">Inflow Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-green">@userCurrency. @highestInflow</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-green">@userCurrency. @lowestInflow</span>
                </div>
            </div>

            <!-- Outflow Statistics -->
            <div class="stat-card">
                <div class="stat-title">Outflow Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-red">@userCurrency. @highestOutflow</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-red">@userCurrency. @lowestOutflow</span>
                </div>
            </div>

            <!-- Debt Statistics -->
            <div class="stat-card">
                <div class="stat-title">Debt Statistics</div>
                <div class="stat-row">
                    <span>Highest:</span>
                    <span class="amount-yellow">@userCurrency. @highestDebt</span>
                </div>
                <div class="stat-row">
                    <span>Lowest:</span>
                    <span class="amount-yellow">@userCurrency. @lowestDebt</span>
                </div>
            </div>
        </div>

        <!-- Top 5 Transactions Section -->
        <div class="transactions-card">
            <div class="stat-title">Top 5 Transactions</div>
            @foreach (var transaction in topTransactions)
            {
                <div class="transaction-item">
                    <span>@transaction.Date.ToString("yyyy-MM-dd")</span>
                    <span>@transaction.Name</span>
                    <span class="tag @(transaction.Tag?.ToLower() ?? "no-tag")">@transaction.Tag</span>
                    <span style="font-weight:500;" class="amount-@(
                        transaction.Type == "Credit" ? "green" :
                        transaction.Type == "Debit" ? "red" :
                        transaction.Type == "Debt" ? "yellow" : "default")">
                        @userCurrency. @transaction.Amount
                    </span>
                </div>
            }
        </div>
    </div>

    <div style="display:flex; gap:3rem;" class="debt-donut">
        <!-- Remaining Debts Data -->
        <div class="debts-card">
            <div class="stat-title">Top 5 Remaining Debts</div>
            <div class="filter-group">
                <label for="filterStartDate">Start Date:</label>
                <input type="date" id="filterStartDate" @bind="startDate" />

                <label for="filterEndDate">End Date:</label>
                <input type="date" id="filterEndDate" @bind="endDate" />
            </div>
            <!-- Apply Filter Button -->
            <div class="filter-buttons">
                <div class="filter-button" style="background-color:gray">
                    <button @onclick="ClearFilters" class="clear-filter-btn">Clear Filters</button>
                </div>
                <div class="filter-button">
                    <button @onclick="ApplyFilter">Apply Filter</button>
                </div>
            </div>
            @if (topRemainingDebts == null || topRemainingDebts.Count == 0)
            {
                <p>No remaining debts found.</p>
            }
            else
            {
                @foreach (var debt in topRemainingDebts)
                {
                    <div class="transaction-item">
                        <span>@debt.Name</span>
                        <span style="color:#eab308; font-weight:500;">@userCurrency.@debt.Amount</span>
                        <span class="tag @(debt.Tag?.ToLower() ?? "no-tag")">@debt.Tag</span>
                        <span>Source: @debt.Source</span>
                        <span>Date: @debt.Date.ToString("yyyy-MM-dd")</span>
                        <span>Due Date: <span style="color:red;">@debt.DueDate?.ToString("yyyy-MM-dd")</span></span>
                    </div>
                }
            }
        </div>

        <!-- Pie Chart -->
        <div class="piechart">
            <p style="font-size: 16px; font-weight: 600;">Donut Chart Representing Data Statistics</p>
            <MudChart ChartType="ChartType.Donut" LegendPosition="@LegendPosition" Width="300px" Height="300px"
                      InputData="@data" InputLabels="@labels">
            </MudChart>
        </div>
    </div>

    <!-- Bar Graph -->
    <div class="bargraph">
        @if (Series.Any() && XAxisLabels.Any())
        {
            <p style="font-size: 16px; font-weight: 600;">Bar Graph Representing Inflow, Outflow, and Debt</p>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="500px" @bind-SelectedIndex="selectedIndex"></MudChart>
        }
        else
        {
            <MudText Typo="Typo.h6">No data available to display the chart.</MudText>
        }
    </div>
</div>
