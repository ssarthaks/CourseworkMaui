@page "/overalldebts"
@inject ExpenwiseTracker.Services.DbConnectionService DatabaseService
@inject IJSRuntime JSRuntime
@using ExpenwiseTracker.Model;
@using ExpenwiseTracker.Services.Interface
@inject ITransactionService TransactionService

<div class="debt-container">

    <h1 class="debt-header">Overall Debt Calculation</h1>
    <div style="display:flex; justify-content:space-between;">
        <p style="color:red;">Total Debt Count: @totalDebtCount</p>
        <p style="color:green;">Paid Debt Count: @paidDebtCount</p>
        <p style="color:#a88b2c;">Remaining Debt Count: @remainingDebtCount</p>
    </div>

    <!-- Filters Section -->
    <div class="filters">
        <div class="filter-group">
            <label for="searchName">Search by Name:</label>
            <input type="text" id="searchName" @bind="searchName" @oninput="ApplyFilters" placeholder="Enter name..." />
        </div>

        <div class="filter-group">
            <label for="sortDate">Sort by Date:</label>
            <select id="sortDate" @bind="sortOrder" @bind:event="onchange">
                <option value="desc">Newest to Oldest</option>
                <option value="asc">Oldest to Newest</option>
            </select>
        </div>


        <div class="filter-group">
            <label for="filterDate">Filter by Date:</label>
            <input type="date" id="filterDate" @bind="selectedDate" @bind:event="onchange" />
        </div>
    </div>

    @if (filteredTransactions == null)
    {
        <p>Loading...</p>
    }
    else if (filteredTransactions.Count == 0)
    {
        <p>No debts found.</p>
    }
    else
    {
        <table class="debt-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Tag</th>
                    <th>Source</th>
                    <th>Due Date</th>
                    <th>Clear Debt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in paginatedTransactions)
                {
                    <tr>
                        <td>@transaction.Id</td>
                        <td>@transaction.Date.ToString("MM/dd/yyyy")</td>
                        <td>@transaction.Name</td>
                        <td><span class="transaction-type @(GetTransactionTypeClass(transaction.Type))">@transaction.Type</span></td>
                        <td class="amount">@FormatAmount(transaction.Amount)</td> <!-- Use FormatAmount method -->
                        <td><span class="tag">@transaction.Tag</span></td>
                        <td>@transaction.Source</td>
                        <td>@transaction.DueDate?.ToString("MM/dd/yyyy")</td>
                        <td>
                            @if (transaction.IsPaid)
                            {
                                <p style="color: #999; font-style: italic; text-decoration: line-through; pointer-events: none;">Cleared</p>
                            }
                            else
                            {
                                <button class="clear-debt-btn" @onclick="() => ClearDebt(transaction)">Clear Debt</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Controls -->
        <div class="pagination-controls">
            <button @onclick="PreviousPage" disabled="@IsPreviousButtonDisabled()">Previous</button>
            <span>Page @currentPage of @totalPages</span>
            <button @onclick="NextPage" disabled="@IsNextButtonDisabled()">Next</button>
        </div>
    }
</div>

@code {
    private List<Transaction> transactions;
    private List<Transaction> filteredTransactions;
    private List<Transaction> paginatedTransactions;

    private double currentBalance;

    private string searchName = string.Empty;
    private DateTime? selectedDate = null;
    private string sortOrder = "asc"; 

    // Debt counts
    private int totalDebtCount;
    private int paidDebtCount;
    private int remainingDebtCount;

    // Currency from sessionStorage
    private string userCurrency = string.Empty;

    // Pagination state
    private int currentPage = 1;
    private const int itemsPerPage = 5;

    private int totalPages => (int)Math.Ceiling((double)filteredTransactions.Count / itemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        userCurrency = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "preferredCurrency");

        // Get all transactions from the database
        transactions = DatabaseService.RetrieveAllTransactions();

        // Filter and sort by "Debt" transactions initially
        filteredTransactions = transactions.Where(t => t.Type == "Debt").ToList();

        filteredTransactions = sortOrder switch
        {
            "asc" => filteredTransactions.OrderBy(t => t.Date).ToList(),
            "desc" => filteredTransactions.OrderByDescending(t => t.Date).ToList(),
            _ => filteredTransactions
        };

        // Calculate debt counts
        CalculateDebtCounts();

        // Update pagination after initial load
        UpdatePagination();
    }


    private string GetTransactionTypeClass(string type)
    {
        return type.ToLower() switch
        {
            "debt" => "type-debt",
            _ => "type-neutral"
        };
    }

    private string FormatAmount(double amount)
    {
        // Display the amount with the selected currency
        return $"{userCurrency}. {amount:N2}";
    }

    // Filter logic
    private void ApplyFilters()
    {
        // Filter by "Debt" type only
        filteredTransactions = transactions.Where(t => t.Type == "Debt").ToList();

        // Filter by name if provided
        if (!string.IsNullOrWhiteSpace(searchName))
        {
            filteredTransactions = filteredTransactions.Where(t => t.Name.Contains(searchName, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        // Filter by date if selected
        if (selectedDate.HasValue)
        {
            filteredTransactions = filteredTransactions.Where(t => t.Date.Date == selectedDate.Value.Date).ToList();
        }

        // Sort by date
        filteredTransactions = sortOrder switch
        {
            "asc" => filteredTransactions.OrderBy(t => t.Date).ToList(),
            "desc" => filteredTransactions.OrderByDescending(t => t.Date).ToList(),
            _ => filteredTransactions
        };

        // Recalculate debt counts after applying filters
        CalculateDebtCounts();

        // After applying filters, update the pagination
        UpdatePagination();
    }

    // Calculate total debt, paid debt, and remaining debt counts
    private void CalculateDebtCounts()
    {
        totalDebtCount = filteredTransactions.Count;
        paidDebtCount = filteredTransactions.Count(t => t.IsPaid);
        remainingDebtCount = totalDebtCount - paidDebtCount;
    }

    // Pagination logic
    private void UpdatePagination()
    {
        // Calculate the items for the current page
        int skip = (currentPage - 1) * itemsPerPage;
        paginatedTransactions = filteredTransactions.Skip(skip).Take(itemsPerPage).ToList();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagination();
        }
    }

    private bool IsNextButtonDisabled() => currentPage >= totalPages;

    private bool IsPreviousButtonDisabled() => currentPage <= 1;

    // Clear the debt when button is clicked
    private async Task ClearDebt(Transaction transaction)
    {
        // Mark the transaction as paid in the database
        transaction.IsPaid = true;

        // Update the transaction in the database
        DatabaseService.EstablishConnection().Update(transaction);

        // Recalculate debt counts
        CalculateDebtCounts();

        // Refresh the transaction list to reflect changes
        transactions = DatabaseService.RetrieveAllTransactions();
        filteredTransactions = transactions.Where(t => t.Type == "Debt").ToList();
        UpdatePagination();
    }
}
