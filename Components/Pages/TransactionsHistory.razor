@page "/transactionhistory"
@using ExpenwiseTracker.Model
@inject ExpenwiseTracker.Services.DbConnectionService DatabaseService
@inject ExpenwiseTracker.Services.Interface.IUserService UserService
@inject IJSRuntime JSRuntime

<div class="transactions-container">
    <h1 class="transactions-header">Recent Transactions</h1>
    <p style="color:red;">Total Transactions: @totalTransactions</p>

    <!-- Filters Section -->
    <div class="filters">
        <div class="filter-group">
            <label for="searchName">Search by Name:</label>
            <input type="text" id="searchName" @bind="searchName" @oninput="ApplyFilters" placeholder="Enter name..." />
        </div>

        <div class="filter-group">
            <label for="filterType">Filter by Type:</label>
            <select id="filterType" @bind="selectedType" @bind:event="onchange">
                <option value="">All Types</option>
                <option value="Debit">Debit</option>
                <option value="Credit">Credit</option>
                <option value="Debt">Debt</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="sortDate">Sort by Date:</label>
            <select id="sortDate" @bind="sortOrder" @bind:event="onchange">
                <option value="desc">Newest to Oldest</option>
                <option value="asc">Oldest to Newest</option>
            </select>
        </div>


        <div class="filter-group">
            <label for="filterDate">Filter by Date:</label>
            <input type="date" id="filterDate" @bind="selectedDate" @bind:event="onchange" />
        </div>
    </div>

    @if (filteredTransactions == null)
    {
        <p>Loading...</p>
    }
    else if (filteredTransactions.Count == 0)
    {
        <p>No transactions found.</p>
    }
    else
    {
        <table class="transactions-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Title</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Tags</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in paginatedTransactions)
                {
                    <tr>
                        <td>@transaction.Id</td>
                        <td>@transaction.Date.ToString("MM/dd/yyyy")</td>
                        <td>@transaction.Name</td>
                        <td class="amount">@FormatCurrency(transaction.Amount)</td>
                        <td><span class="transaction-type @(GetTransactionTypeClass(transaction.Type))">@transaction.Type.Substring(0, 1).ToUpper()@transaction.Type.Substring(1).ToLower()</span></td>
                        <td><span class="tag">@transaction.Tag</span></td>
                        <td>@transaction.Notes</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Controls -->
        <div class="pagination-controls">
            <button @onclick="PreviousPage" disabled="@IsPreviousButtonDisabled()">Previous</button>
            <span>Page @currentPage of @totalPages</span>
            <button @onclick="NextPage" disabled="@IsNextButtonDisabled()">Next</button>
        </div>
    }
</div>

@code {
    private List<Transaction> transactions;
    private List<Transaction> filteredTransactions;
    private List<Transaction> paginatedTransactions;
    private int totalTransactions;

    private string searchName = string.Empty;
    private string selectedType = string.Empty;
    private DateTime? selectedDate = null;
    private string sortOrder = "asc"; 


    // Pagination state
    private int currentPage = 1;
    private const int itemsPerPage = 5;

    private int totalPages => (int)Math.Ceiling((double)filteredTransactions.Count / itemsPerPage);

    private string userCurrency;

    protected override async Task OnInitializedAsync()
    {
        userCurrency = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "preferredCurrency");

        // Get all transactions from the database
        transactions = DatabaseService.RetrieveAllTransactions();

        // Sort by the default sort order
        transactions = sortOrder == "asc"
            ? transactions.OrderBy(t => t.Date).ToList()
            : transactions.OrderByDescending(t => t.Date).ToList();

        filteredTransactions = transactions;
        totalTransactions = transactions.Count;

        UpdatePagination();
    }



    private string GetTransactionTypeClass(string type)
    {
        return type.ToLower() switch
        {
            "credit" => "type-inflow",
            "debit" => "type-outflow",
            "debt" => "type-debt",
            _ => "type-neutral"
        };
    }

    // Format the amount based on the user's currency preference
    private string FormatCurrency(double amount)
    {
        if (string.IsNullOrEmpty(userCurrency)) return $"{amount:0.00}"; // Fallback if no currency is set

        switch (userCurrency.ToUpper())
        {
            case "USD":
                return $"USD. {amount:0.00}";
            case "EUR":
                return $"EUR. {amount:0.00}";
            case "GBP":
                return $"GBP. {amount:0.00}";
            case "INR":
                return $"INR. {amount:0.00}";
            case "NPR":
                return $"NPR. {amount:0.00}";
            default:
                return $"{amount:0.00} {userCurrency}"; // Fallback for unknown currencies
        }
    }

    // Filter logic
    private void ApplyFilters()
    {
        filteredTransactions = transactions;

        // Filter by name if provided
        if (!string.IsNullOrWhiteSpace(searchName))
        {
            filteredTransactions = filteredTransactions.Where(t => t.Name.Contains(searchName, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        // Filter by type if selected
        if (!string.IsNullOrEmpty(selectedType))
        {
            filteredTransactions = filteredTransactions.Where(t => t.Type.Equals(selectedType, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        // Filter by date if selected
        if (selectedDate.HasValue)
        {
            filteredTransactions = filteredTransactions.Where(t => t.Date.Date == selectedDate.Value.Date).ToList();
        }

        // Sort transactions by date based on the selected sort order
        filteredTransactions = sortOrder == "asc"
            ? filteredTransactions.OrderBy(t => t.Date).ToList()
            : filteredTransactions.OrderByDescending(t => t.Date).ToList();

        // After applying filters and sorting, update the pagination
        UpdatePagination();
    }


    // Pagination logic
    private void UpdatePagination()
    {
        // Calculate the items for the current page
        int skip = (currentPage - 1) * itemsPerPage;
        paginatedTransactions = filteredTransactions.Skip(skip).Take(itemsPerPage).ToList();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagination();
        }
    }

    private bool IsNextButtonDisabled() => currentPage >= totalPages;

    private bool IsPreviousButtonDisabled() => currentPage <= 1;
} 